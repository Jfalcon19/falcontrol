# =============================================================================
# Falcontrol — Variables de entorno
# Copia este archivo a .env y rellena los valores antes de arrancar.
# NUNCA commitees el archivo .env al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Seguridad — OBLIGATORIO cambiar en producción
# -----------------------------------------------------------------------------
# Clave maestra para cifrado Fernet de credenciales. Genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FALCONTROL_SECRET_KEY=<generate-with-fernet>

# Clave secreta para firmar JWT. Genera con:
#   openssl rand -hex 32
FALCONTROL_JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Algoritmo JWT
FALCONTROL_JWT_ALGORITHM=HS256

# Expiración del access token en minutos
FALCONTROL_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Expiración del refresh token en días
FALCONTROL_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=falcontrol
POSTGRES_USER=falcontrol
POSTGRES_PASSWORD=changeme_in_production

# URL completa (usada por SQLAlchemy async)
# Se construye automáticamente si no se define:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
FALCONTROL_ENV=development
FALCONTROL_DEBUG=true
FALCONTROL_LOG_LEVEL=INFO

# Host y puerto del backend (dentro de Docker)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — orígenes permitidos, separados por coma
# En producción, pon únicamente tu dominio:
FALCONTROL_CORS_ORIGINS=["http://localhost","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Primer usuario administrador (se crea al arrancar si no existe)
# -----------------------------------------------------------------------------
FALCONTROL_FIRST_ADMIN_EMAIL=admin@example.com
FALCONTROL_FIRST_ADMIN_PASSWORD=changeme_in_production

# -----------------------------------------------------------------------------
# Nginx (solo relevante si expones con TLS)
# -----------------------------------------------------------------------------
# NGINX_HOST=falcontrol.example.com
# NGINX_TLS_CERT=/etc/nginx/certs/fullchain.pem
# NGINX_TLS_KEY=/etc/nginx/certs/privkey.pem
