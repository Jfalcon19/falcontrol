{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",

      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git remote:*)",
      "Bash(git config --get:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",

      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",

      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pytest:*)",
      "Bash(pip-audit)",
      "Bash(uv pip list:*)",
      "Bash(uv pip show:*)",
      "Bash(python -m:*)",
      "Bash(python -V)",
      "Bash(python --version)",

      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm list:*)",
      "Bash(npm audit)",
      "Bash(npx vue-tsc --noEmit)",

      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",

      "Bash(virsh list:*)",
      "Bash(virsh dominfo:*)",
      "Bash(virsh net-list:*)",
      "Bash(virsh pool-list:*)",
      "Bash(virsh domifaddr:*)",
      "Bash(virsh net-dhcp-leases:*)",

      "Bash(ansible --version)",
      "Bash(ansible-runner --version)",
      "Bash(ansible -i:* -m ping:*)",
      "Bash(ansible -i:* -m win_ping:*)",
      "Bash(ansible-inventory --list:*)",
      "Bash(ansible-inventory --graph:*)",

      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm -rf:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",

      "Bash(virsh destroy:*)",
      "Bash(virsh undefine:*)",
      "Bash(virsh pool-destroy:*)",
      "Bash(virsh pool-delete:*)",
      "Bash(virsh net-destroy:*)",

      "Bash(dd if=:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",

      "Bash(sudo pip install:*)",
      "Bash(sudo npm install -g:*)",
      "Bash(sudo apt remove:*)",
      "Bash(sudo apt purge:*)",
      "Bash(sudo dpkg --remove:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",

      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/falcontrol_ed25519)"
    ]
  }
}
